          }
        }
      }
    },
    "reasonLabel" : { "type" : "label", "position" : [10, 62], "value" : "", "hAnchor" : "left", "vAnchor" : "top", "wrapWidth" : 460 },
    "formulaLabel" : { "type" : "label", "position" : [10, 14], "value" : "", "hAnchor" : "left", "vAnchor" : "top", "wrapWidth" : 460 }
  },

  "paneLayout" : {
    "positionLocked" : true,
    "anchor" : "center",
    "size" : [488, 300]
  }

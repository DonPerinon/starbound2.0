{
  "title" : { "title" : "SB2 Market", "subtitle" : "rozpis dynamickych cien" },
  "scripts" : ["/objects/sb2_market/sb2_market_pane.lua"],
  "scriptDelta" : 5,

  "sb2" : {
    "headerFormat" : "%-14s %5s %6s %6s %6s %5s %6s %6s",
    "headerColumns" : ["item", "base", "M_loc", "A_reg", "M_glob", "tlak", "final", "d.vcera"],
    "rowFormat" : "%-14s %5d %6.2f %+6.2f %6.2f %+4d%% %6d %+5d%%",
    "itemWidth" : 14,
    "reasonFormat" : "%+d%% %s",
    "formulaText" : "final = base x M_loc x (1 + A_reg) x M_glob x (1 + tlak)   clamp [0.1x .. 10x]",
    "categories" : ["all", "ore", "food", "fuel", "refined_metal", "medicine", "advanced_component"],
    "text" : {
      "loading" : "Nacitavam...",
      "noState" : "Tato stanica este nema trhovy stav. Otvor merchanta alebo (admin) pouzi Seed demo.",
      "error" : "Chyba pri citani stavu, pozri starbound.log.",
      "stationDay" : "%s  |  den %d  |  posledny prepocet den %d  |  %d riadkov",
      "changedOn" : "Len zmenene: ANO",
      "changedOff" : "Len zmenene: nie",
      "selectHint" : "Vyber riadok pre dovody ceny.",
      "seeded" : "Demo stav vytvoreny, nacitavam..."
    }
  },

  "gui" : {
    "background" : {
      "type" : "background",
      "fileHeader" : "/interface/scripted/blockbuilder/blockbuilderheader.png",
      "fileBody" : "/interface/scripted/blockbuilder/blockbuilderbody.png",
      "fileFooter" : "/interface/scripted/blockbuilder/blockbuilderfooter.png"
    },
    "statusLabel" : { "type" : "label", "position" : [10, 274], "value" : "", "hAnchor" : "left", "vAnchor" : "top", "wrapWidth" : 460 },

    "catAll"  : { "type" : "button", "base" : "/interface/button.png", "hover" : "/interface/buttonhover.png", "pressed" : "/interface/buttonpress.png", "pressedOffset" : [0, 0], "position" : [10, 250],  "caption" : "vsetko",   "callback" : "filterAll" },
    "catOre"  : { "type" : "button", "base" : "/interface/button.png", "hover" : "/interface/buttonhover.png", "pressed" : "/interface/buttonpress.png", "pressedOffset" : [0, 0], "position" : [72, 250],  "caption" : "ore",      "callback" : "filterOre" },
    "catFood" : { "type" : "button", "base" : "/interface/button.png", "hover" : "/interface/buttonhover.png", "pressed" : "/interface/buttonpress.png", "pressedOffset" : [0, 0], "position" : [134, 250], "caption" : "food",     "callback" : "filterFood" },
    "catFuel" : { "type" : "button", "base" : "/interface/button.png", "hover" : "/interface/buttonhover.png", "pressed" : "/interface/buttonpress.png", "pressedOffset" : [0, 0], "position" : [196, 250], "caption" : "fuel",     "callback" : "filterFuel" },
    "catMetal": { "type" : "button", "base" : "/interface/button.png", "hover" : "/interface/buttonhover.png", "pressed" : "/interface/buttonpress.png", "pressedOffset" : [0, 0], "position" : [258, 250], "caption" : "metal",    "callback" : "filterMetal" },
    "catMed"  : { "type" : "button", "base" : "/interface/button.png", "hover" : "/interface/buttonhover.png", "pressed" : "/interface/buttonpress.png", "pressedOffset" : [0, 0], "position" : [320, 250], "caption" : "medicine", "callback" : "filterMed" },
    "catAdv"  : { "type" : "button", "base" : "/interface/button.png", "hover" : "/interface/buttonhover.png", "pressed" : "/interface/buttonpress.png", "pressedOffset" : [0, 0], "position" : [382, 250], "caption" : "advanced", "callback" : "filterAdv" },

    "changedToggle" : { "type" : "button", "base" : "/interface/button.png", "hover" : "/interface/buttonhover.png", "pressed" : "/interface/buttonpress.png", "pressedOffset" : [0, 0], "position" : [10, 228], "caption" : "Len zmenene: nie", "callback" : "toggleChanged" },
    "refreshButton" : { "type" : "button", "base" : "/interface/button.png", "hover" : "/interface/buttonhover.png", "pressed" : "/interface/buttonpress.png", "pressedOffset" : [0, 0], "position" : [134, 228], "caption" : "Obnovit", "callback" : "refresh" },
    "seedButton" : { "type" : "button", "base" : "/interface/button.png", "hover" : "/interface/buttonhover.png", "pressed" : "/interface/buttonpress.png", "pressedOffset" : [0, 0], "position" : [382, 228], "caption" : "Seed demo", "callback" : "seedDemo", "visible" : false },

    "headerLabel" : { "type" : "label", "position" : [10, 210], "value" : "", "hAnchor" : "left", "vAnchor" : "top" },
    "scrollArea" : {
      "type" : "scrollArea",
      "rect" : [8, 70, 472, 206],
      "children" : {
        "rowList" : {
          "type" : "list",
          "callback" : "rowSelected",
          "schema" : {
            "selectedBG" : "/interface/crafting/craftableselected.png",
